# Variables para ejecutar la API Express y PostgreSQL
NODE_ENV=development
PORT=4444
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/cuidarteplus
DATABASE_SSL=false
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_64_CARACTERES
# Opcional: dominio autorizado adicional, separado por coma
FRONTEND_URL=http://localhost:3333
# Para desarrollo con frontend separado: VITE_API_URL=http://localhost:4444 en FRONTEND/.env.local
