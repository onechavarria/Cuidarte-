{
  "name": "cuidarteplus",
  "version": "1.1.0",
  "private": true,
  "description": "Cuidarte+ | React + Express + PostgreSQL, despliegue sin Docker",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "npm install --prefix BACKEND && npm install --prefix FRONTEND",
    "dev": "npm run start --prefix BACKEND",
    "dev:frontend": "npm run dev --prefix FRONTEND -- --host 0.0.0.0 --port 3333",
    "build": "npm run build --prefix FRONTEND",
    "start": "node BACKEND/src/app.js",
    "check": "node --check BACKEND/src/app.js && node --check BACKEND/src/db.js && node -e \"JSON.parse(require('fs').readFileSync('BACKEND/src/openapi.json'))\""
  }
}
